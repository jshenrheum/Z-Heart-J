{
  "name": "z-heart-j",
  "private": true,
  "version": "0.1.0",
  "description": "Z Heart J — a private shared PWA for Jeffrey and Zul. Stage 1: responsive shell and core journeys on demo data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "build:local": "node scripts/build-local.mjs",
    "preview:local": "node scripts/preview-local.mjs",
    "typecheck:local": "tsc -p tsconfig.local.json",
    "contrast": "node scripts/check-contrast.mjs",
    "e2e": "node e2e/stage1.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  }
}
