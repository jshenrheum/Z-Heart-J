{
  "name": "z-heart-j",
  "private": true,
  "version": "0.2.0",
  "description": "Z Heart J — a private shared PWA for Jeffrey and Zul.",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build && node scripts/check-dist.mjs dist",
    "build:demo": "vite build --mode demo && node scripts/check-dist.mjs dist-demo",
    "preview:demo": "node scripts/preview-demo.mjs",
    "preview:local": "tsx scripts/local-preview.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:worker": "node --import tsx --test --test-concurrency=1 tests/worker/*.test.ts",
    "contrast": "node scripts/check-contrast.mjs",
    "e2e": "node e2e/stage1.cjs",
    "e2e:live": "node e2e/stage2.cjs",
    "icons": "node scripts/make-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply z-heart-j --local",
    "db:migrate": "wrangler d1 migrations apply z-heart-j --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261023.0-beta",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.153.0"
  }
}
