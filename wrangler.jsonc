// Z ♥ J — Cloudflare Worker configuration.
// Placeholders (REPLACE_…) are filled in by the owner during setup; see README → "Deploy".
// Secrets are never written here: MEMBER_EMAILS and PROTECTED_DATA_KEY are set with
// `wrangler secret put` (or the dashboard) and live only in Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "z-heart-j",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,

  // Served at https://z-heart-j.jshenrheum.workers.dev, behind its own Cloudflare
  // Access application (README → Deploy). The Worker also checks the Access token
  // itself, so without that application every request is refused. No per-version
  // preview addresses: they would sit outside the sign-in.
  "workers_dev": true,
  "preview_urls": false,

  // The built app. The Worker runs first on every request so it can check the
  // Access token and add the security headers, then hands pages to this binding.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "z-heart-j",
      "database_id": "1799d4ec-db4a-4ab8-8ae5-66a8ba80e924",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Your Zero Trust team (shared with RheumDx; the application below is Z ♥ J’s own).
    "ACCESS_TEAM_DOMAIN": "the-elite-connection.cloudflareaccess.com",
    // The Z ♥ J Access application's Audience (AUD) tag — not RheumDx's.
    "ACCESS_AUD": "7c471d2cc568d0df3393778c817e1063c1c93adce1620cc90cc51b4cd10b5aa8",
    "HOUSEHOLD_ID": "zj"
  },

  // Daily: purge anything that has been in the trash for more than 30 days.
  "triggers": { "crons": ["17 8 * * *"] }
}
