// Z ♥ J — Cloudflare Worker configuration.
// Placeholders (REPLACE_…) are filled in by the owner during setup; see README → "Deploy".
// Secrets are never written here: MEMBER_EMAILS and PROTECTED_DATA_KEY are set with
// `wrangler secret put` (or the dashboard) and live only in Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "z-heart-j",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,

  // Reachable only on the custom domain that Cloudflare Access protects. The
  // workers.dev and preview URLs would sit outside Access, so they stay off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "REPLACE_WITH_PRODUCTION_HOSTNAME", "custom_domain": true }],

  // The built app. The Worker runs first on every request so it can check the
  // Access token and add the security headers, then hands pages to this binding.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "z-heart-j",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // e.g. "yourteam.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_ACCESS_TEAM_DOMAIN",
    // The Access application's Audience (AUD) tag.
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUD",
    "HOUSEHOLD_ID": "zj"
  },

  // Daily: purge anything that has been in the trash for more than 30 days.
  "triggers": { "crons": ["17 8 * * *"] }
}
